{
  "expo": {
    "name": "CMPort",
    "slug": "cmport-app",
    "scheme": "cmport",
    "version": "0.16.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.cmport.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.cmport.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#EEF2F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class com.reactnativeandroidwidget.** { *; }\n-keep class expo.modules.pip.** { *; }"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "O CM Port não usa a câmera do seu aparelho. O pedido vem da biblioteca de vídeo ao vivo e pode ser recusado.",
          "microphonePermission": "O CM Port não usa o microfone do seu aparelho. O pedido vem da biblioteca de vídeo ao vivo e pode ser recusado."
        }
      ],
      "expo-font",
      "expo-video",
      "expo-sharing",
      "expo-asset",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O CM Port salva na galeria as gravações que você baixar.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O CM Port usa as suas fotos só para você escolher a foto do perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-screen-orientation",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O CM Port usa o Face ID para trancar o aplicativo, se você ligar essa opção em Minha conta."
        }
      ],
      [
        "expo-pip",
        {}
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A8A",
          "defaultChannel": "cameras"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Camera",
              "label": "CM Port: câmera",
              "description": "A última imagem da sua câmera favorita.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f40ebba-cb92-488d-a98e-6453d1ad1e2a"
      }
    },
    "owner": "biel.pedretti"
  }
}
