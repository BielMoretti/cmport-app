# Endereço da API do aplicativo dos moradores.
# Copie este arquivo para .env.local e ajuste. O .env.local não vai para o git.
# Depois de mudar, reinicie a prévia com:  npx expo start --web --port <porta> --clear
#
# Sem barra no final. O app junta os caminhos (/auth/login, /cameras, ...) a este endereço.
EXPO_PUBLIC_API_URL=https://dash.cmport.com.br/api/cliente/v1

# Exemplos:
#   API nova, quando o Atila liberar:   EXPO_PUBLIC_API_URL=https://<endereco-da-api-nova>/api/v1
#   API rodando no seu computador:      EXPO_PUBLIC_API_URL=http://<ip-da-maquina>:8000/api/v1
